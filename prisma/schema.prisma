generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum SubscriptionPlan {
  BASIC
  STANDARD
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AdminAction {
  USER_BAN
  USER_UNBAN
  SUB_MODIFY
  CONTENT_CREATE
  CONTENT_DELETE
  TICKET_CLOSE
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  password      String?
  image         String?

  role          Role            @default(USER)

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  isBanned      Boolean         @default(false)
  banReason     String?
  bannedAt      DateTime?
  banExpiresAt  DateTime?

  accounts      Account[]
  comments      Comment[]
  notifications Notification[]
  pageViews     PageView[]
  payments      Payment[]
  sessions      Session[]
  subscription  Subscription?
  tickets       SupportTicket[]
  watchHistory  WatchHistory[]
  auditLogs     AuditLog[]

  favorites Favorite[]
  ratings   Rating[]

  @@index([role])
  @@index([isBanned])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String             @unique
  plan      SubscriptionPlan   @default(BASIC)
  status    SubscriptionStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id         String           @id @default(cuid())
  userId     String
  amount     Int
  currency   String           @default("USD")
  plan       SubscriptionPlan
  status     PaymentStatus    @default(PENDING)
  providerId String?          @unique
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model SupportTicket {
  id        String        @id @default(cuid())
  userId    String?
  firstName String
  lastName  String
  email     String
  phone     String?
  message   String
  status    TicketStatus  @default(OPEN)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  replies   TicketReply[]

  @@index([userId])
  @@index([createdAt])
}

model TicketReply {
  id        String        @id @default(cuid())
  ticketId  String
  message   String
  fromAdmin Boolean       @default(false)
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model Movie {
  id         String         @id
  title      String
  posterPath String?
  createdAt  DateTime       @default(now())

  comments   Comment[]
  watchedBy  WatchHistory[]

  favorites  Favorite[]
  ratings    Rating[]
}

model Show {
  id         String         @id
  name       String
  posterPath String?
  createdAt  DateTime       @default(now())

  comments   Comment[]
  watchedBy  WatchHistory[]
  favorites  Favorite[]
  ratings    Rating[]
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  movieId   String?
  showId    String?
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie? @relation(fields: [movieId], references: [id], onDelete: Cascade)
  show  Show?  @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([movieId])
  @@index([showId])

  @@unique([userId, movieId])
  @@unique([userId, showId])
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  movieId   String?
  showId    String?
  rating    Int
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie? @relation(fields: [movieId], references: [id], onDelete: Cascade)
  show  Show?  @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([movieId])
  @@index([showId])

  @@unique([userId, movieId])
  @@unique([userId, showId])
}

model WatchHistory {
  id         String   @id @default(cuid())
  userId     String
  movieId    String?
  showId     String?
  progress   Int      @default(0)
  episodeId  String?
  isFinished Boolean  @default(false)
  watchedAt  DateTime @default(now()) @updatedAt
  movie      Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  show       Show?    @relation(fields: [showId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@unique([userId, showId])
  @@index([userId])
  @@index([movieId])
  @@index([showId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  userId    String
  movieId   String?
  showId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  movie     Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  show      Show?    @relation(fields: [showId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([movieId])
  @@index([showId])
  @@index([createdAt])
}

model PageView {
  id         String   @id @default(cuid())
  userId     String?
  path       String
  method     String   @default("GET")
  statusCode Int      @default(200)
  duration   Int?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([userId, createdAt])
}

model AuditLog {
  id        String      @id @default(cuid())
  adminId   String
  action    AdminAction
  targetId  String?
  changes   Json?
  ipAddress String?
  createdAt DateTime    @default(now())
  admin     User        @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([createdAt])
}