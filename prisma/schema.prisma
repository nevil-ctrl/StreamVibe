generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// БЛОК: ПОЛЬЗОВАТЕЛИ И АВТОРИЗАЦИЯ (NextAuth)
// ==========================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tickets       SupportTicket[]
  notifications Notification[]
  accounts      Account[]
  sessions      Session[]
  subscription  Subscription?
  payments      Payment[]
  watchHistory  WatchHistory[] // История просмотров юзера
  comments      Comment[]      // Комментарии юзера
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// БЛОК: БИЗНЕС-ЛОГИКА И ОПЛАТЫ
// ==========================================

model Subscription {
  id        String             @id @default(cuid())
  userId    String             @unique
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan   @default(BASIC)
  status    SubscriptionStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model Payment {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int              // Сумма в копейках/центах (например, 49900 вместо 499.00)
  currency  String           // "RUB", "USD", "EUR"
  plan      SubscriptionPlan
  status    String           // "SUCCESS", "FAILED", "PENDING"
  createdAt DateTime         @default(now())
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String?  // опционально — если юзер залогинен
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  firstName String
  lastName  String
  email     String
  phone     String?
  message   String   @db.Text
  status    TicketStatus @default(OPEN)
  
  // 👇 Добавлено поле для связи с ответами
  replies   TicketReply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TicketReply {
  id        String        @id @default(cuid())
  ticketId  String
  // 👇 Исправлено: указали явные поля привязки и настроили каскадное удаление
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message   String        @db.Text
  fromAdmin Boolean       @default(false)
  createdAt DateTime      @default(now())
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "PAYMENT_SUCCESS" | "SUBSCRIPTION_ACTIVATED" | "SUBSCRIPTION_EXPIRED"
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}
// ==========================================
// БЛОК: КОНТЕНТ, КИНОТЕАТР И АКТИВНОСТЬ
// ==========================================

model Movie {
  id          String         @id // ID из TMDB (например, "157336")
  title       String
  posterPath  String?
  
  watchedBy   WatchHistory[]
  comments    Comment[]
  createdAt   DateTime       @default(now())
}

model Show {
  id          String         @id // ID сериала из TMDB
  name        String
  posterPath  String?
  
  watchedBy   WatchHistory[]
  comments    Comment[]
  createdAt   DateTime       @default(now())
}

model WatchHistory {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  movieId    String?
  movie      Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  
  showId     String?  
  show       Show?    @relation(fields: [showId], references: [id], onDelete: Cascade)
  
  progress   Int      @default(0)    
  episodeId  String?  
  isFinished Boolean  @default(false)
  
  watchedAt  DateTime @default(now()) @updatedAt

  @@unique([userId, movieId])
  @@unique([userId, showId]) 
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  movieId   String?
  movie     Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  
  showId    String?  
  show      Show?    @relation(fields: [showId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// ЭНУМЫ (Ограничения типов данных)
// ==========================================

enum Role {
  USER
  ADMIN
}

enum SubscriptionPlan {
  BASIC
  STANDARD
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}