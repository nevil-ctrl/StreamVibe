# ==============================================================================
# STREAMVIBE APP ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Authentication (NextAuth / Auth.js v5)
# Generate a new secret using: npx auth secret
AUTH_SECRET=your_auth_js_secret_here
JWT_SECRET=your_jwt_secret_here
API_SECRET=your_api_secret_here

# Database Connection (Docker / PostgreSQL)
# Example: postgresql://username:password@localhost:5433/database_name
DATABASE_URL=postgresql://admin:password@localhost:5433/streamvibe

# S3 Object Storage (AWS / MinIO)
NEXT_PUBLIC_S3_URL=https://your-bucket.s3.amazonaws.com
S3_ACCESS_KEY=your_s3_access_key_here
S3_SECRET_KEY=your_s3_secret_key_here

# Google OAuth Integration
AUTH_GOOGLE_ID=your_google_client_id_here.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_client_secret_here

# The Movie Database (TMDB) API
TMDB_API_KEY=your_tmdb_api_key_here
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here
TMDB_ACCESS_TOKEN=your_tmdb_bearer_access_token_here
NEXT_PUBLIC_TMDB_ACCESS_TOKEN=your_tmdb_bearer_access_token_here

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
