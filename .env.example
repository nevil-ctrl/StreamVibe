# ==============================================================================
# STREAMVIBE APP ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXTAUTH_URL=http://localhost:3000

# Authentication (NextAuth / Auth.js v5)
# Generate: npx auth secret
AUTH_SECRET=your_auth_js_secret_here

# Database Connection (PostgreSQL)
# Use 127.0.0.1 instead of localhost on Windows to avoid IPv6 delays
DATABASE_URL=postgresql://username:password@127.0.0.1:5433/database_name
# Optional pool / SSL tuning for hosted Postgres (Neon, Supabase, RDS, etc.)
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_POOL_MAX=10
# DATABASE_CONNECT_TIMEOUT_MS=5000

# Google OAuth Integration
AUTH_GOOGLE_ID=your_google_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_client_secret

# The Movie Database (TMDB) API
TMDB_API_KEY=your_tmdb_api_key_here
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here
TMDB_ACCESS_TOKEN=your_tmdb_bearer_token_here
NEXT_PUBLIC_TMDB_ACCESS_TOKEN=your_tmdb_bearer_token_here

# Demo MP4 for full HTML5 player (TMDB does not provide full movies)
DEMO_STREAM_URL=https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4

# Email Service (Resend)
RESEND_API_KEY=re_your_resend_key_here
SUPPORT_EMAIL=support@yourdomain.com

# Stripe Configuration (Payment Integration)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# File Uploads (UploadThing)
UPLOADTHING_TOKEN=your_uploadthing_token_here

# PostHog Analytics (Optional)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Analytics (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
